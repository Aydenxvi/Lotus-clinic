# LOTUS CLINIC - Example environment configuration
# Copy this file to .env and replace example values.

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/lotus_clinic"
NODE_ENV=development
PORT=4000

SESSION_SECRET=replace-with-a-long-random-secret
CSRF_SECRET=replace-with-another-long-random-secret

CORS_ORIGINS=http://localhost:8000
COOKIE_SECURE=false

SEED_DEMO_ACCOUNTS=false
SEED_DEMO_PASSWORD=
